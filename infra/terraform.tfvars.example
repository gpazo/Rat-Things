aws_region  = "us-west-2"
environment = "dev"

# Safe bring-up: package Lambda and MicroVM code, provision the control plane,
# then choose a non-mock driver.
default_agent_driver      = "mock"
allow_agent_aws_credential_chain = false
codex_bedrock_model_ids          = ["openai.gpt-5.6-terra"]

# Supplying an ingress secret ARN enables that route. Store only ARNs here,
# never plaintext webhook secrets, tokens, API keys, or workflow URLs.
github_webhook_secret_arn         = "arn:aws:secretsmanager:us-west-2:111122223333:secret:agent/github-webhook-AbCdEf"
github_clone_token_secret_arn     = "arn:aws:secretsmanager:us-west-2:111122223333:secret:agent/github-clone-AbCdEf"
github_notify_token_secret_arn    = "arn:aws:secretsmanager:us-west-2:111122223333:secret:agent/github-notify-AbCdEf"
github_comment_trigger            = "@indubitably"
gitlab_webhook_secret_arn         = "arn:aws:secretsmanager:us-west-2:111122223333:secret:agent/gitlab-webhook-AbCdEf"
gitlab_clone_token_secret_arn     = "arn:aws:secretsmanager:us-west-2:111122223333:secret:agent/gitlab-clone-AbCdEf"
gitlab_notify_token_secret_arn    = "arn:aws:secretsmanager:us-west-2:111122223333:secret:agent/gitlab-notify-AbCdEf"
gitlab_comment_trigger            = "@indubitably"
teams_outgoing_webhook_secret_arn = "arn:aws:secretsmanager:us-west-2:111122223333:secret:agent/teams-outgoing-AbCdEf"
teams_workflow_url_secret_arn     = "arn:aws:secretsmanager:us-west-2:111122223333:secret:agent/teams-workflow-AbCdEf"
# Set threaded-gateway only after deploying an authenticated Teams reply gateway.
teams_delivery_mode               = "workflow"
# teams_reply_gateway_url_secret_arn = "arn:aws:secretsmanager:us-west-2:111122223333:secret:agent/teams-reply-gateway-AbCdEf"

# Self-hosted installations should override the notification APIs and add their
# repository hostnames to allowed_repository_hosts.
# github_api_base_url = "https://github.example.com/api/v3"
# gitlab_api_base_url = "https://gitlab.example.com/api/v4"

# Optional agent credentials. The runner fetches the secret and passes only the
# resolved bearer value to the non-root agent subprocess.
# bedrock_api_key_secret_arn = "arn:aws:secretsmanager:us-west-2:111122223333:secret:agent/bedrock-api-key-AbCdEf"

# Run `aws lambda-microvms list-managed-microvm-image-versions` and pin an
# AVAILABLE al2023-1 version. `npm run package` must have produced the source ZIP.
enable_microvm              = true
microvm_base_image_version  = "1"
# microvm_memory_mib        = 4096

tags = {
  Owner = "platform"
}
