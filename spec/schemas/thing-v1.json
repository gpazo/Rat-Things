{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpazo.github.io/Rat-Things/schemas/thing-v1.json",
  "title": "Rat Things ThingSpec v1",
  "description": "A portable, credential-free definition of a reusable agent automation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "goal", "trigger"],
  "properties": {
    "version": { "const": "1" },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "goal": { "type": "string", "minLength": 1, "maxLength": 100000 },
    "trigger": { "$ref": "#/$defs/trigger" },
    "repository": { "$ref": "#/$defs/repository" },
    "agent": { "$ref": "#/$defs/agent" },
    "connections": { "$ref": "#/$defs/connections" },
    "execution": { "$ref": "#/$defs/execution" },
    "deliver": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/destination" }
    },
    "metadata": {
      "type": "object",
      "description": "Application metadata. thingId, thingName, thingRevision, and scheduledAt are reserved.",
      "propertyNames": {
        "not": { "enum": ["thingId", "thingName", "thingRevision", "scheduledAt"] }
      }
    }
  },
  "$defs": {
    "safeIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,255}$"
    },
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "manual" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "everyMinutes"],
          "properties": {
            "kind": { "const": "interval" },
            "everyMinutes": { "type": "integer", "minimum": 1, "maximum": 525600 },
            "startAt": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "url"],
      "properties": {
        "provider": { "enum": ["github", "gitlab", "generic"] },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "ref": { "type": "string", "minLength": 1, "maxLength": 255 },
        "baseRef": { "type": "string", "minLength": 1, "maxLength": 255 },
        "installationId": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "driver": { "enum": ["codex", "mock"] },
        "model": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$" },
        "sandbox": { "enum": ["read-only", "workspace-write", "danger-full-access"] },
        "reasoningEffort": { "enum": ["low", "medium", "high", "xhigh", "ultra"] },
        "reasoningSummary": { "enum": ["auto", "concise", "detailed", "none"] },
        "personality": { "enum": ["none", "friendly", "pragmatic"] },
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "outputSchema": { "type": "object" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": { "$ref": "#/$defs/safeIdentifier" },
        "approvalPolicy": { "enum": ["untrusted", "on-request", "never"] },
        "approvalsReviewer": { "enum": ["user", "auto-review", "guardian-subagent"] },
        "networkAccess": { "type": "boolean" },
        "webSearch": { "enum": ["disabled", "cached", "indexed", "live"] },
        "computerUse": { "enum": ["disabled", "browser"] },
        "skills": { "$ref": "#/$defs/identifierList" },
        "apps": { "$ref": "#/$defs/identifierList" },
        "mcpServers": { "$ref": "#/$defs/identifierList" }
      },
      "not": {
        "required": ["networkAccess", "computerUse"],
        "properties": {
          "networkAccess": { "const": false },
          "computerUse": { "const": "browser" }
        }
      }
    },
    "identifierList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/safeIdentifier" }
    },
    "connections": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        { "required": ["set"] },
        { "required": ["accounts"], "properties": { "accounts": { "minItems": 1 } } }
      ],
      "properties": {
        "set": { "$ref": "#/$defs/safeIdentifier" },
        "accounts": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/account" }
        }
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account"],
      "properties": {
        "account": { "$ref": "#/$defs/safeIdentifier" },
        "access": { "enum": ["read-only", "read-write", "full", "custom"] },
        "allowOperations": { "$ref": "#/$defs/operationList" },
        "denyOperations": { "$ref": "#/$defs/operationList" }
      },
      "allOf": [
        {
          "if": { "required": ["access"], "properties": { "access": { "const": "custom" } } },
          "then": { "required": ["allowOperations"], "properties": { "allowOperations": { "minItems": 1 } } }
        }
      ]
    },
    "operationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}(?:\\.[a-z][a-zA-Z0-9-]{0,63})+$",
      "maxLength": 256
    },
    "operationList": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/operationId" }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend": { "const": "microvm" },
        "timeoutSeconds": { "type": "integer", "minimum": 30, "maximum": 28000 }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["teams", "slack", "none"] },
        "route": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  }
}
