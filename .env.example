AWS_REGION=us-east-1
AGENT_RUNTIME_API_URL=https://example.execute-api.us-east-1.amazonaws.com
CONVERSATIONS_TABLE_NAME=
CONVERSATION_QUEUE_URL=
CONVERSATION_SLICE_TIMEOUT_SECONDS=600
MICROVM_SESSION_IDLE_SECONDS=1200
MICROVM_SESSION_SUSPENDED_SECONDS=21600
DEFAULT_EXECUTION_BACKEND=microvm
DEFAULT_AGENT_DRIVER=mock
# bedrock is the safe AWS default. Use chatgpt only for trusted local runs on a signed-in device.
CODEX_AUTH_MODE=bedrock
DEFAULT_MODEL=openai.gpt-5.6-terra
# Optional ChatGPT model override. Empty uses the signed-in Codex account's default model.
CODEX_CHATGPT_MODEL=
# Allows network access to agent-spawned commands only in workspace-write mode.
CODEX_TOOL_NETWORK_ACCESS=false
ALLOWED_REPOSITORY_HOSTS=github.com,gitlab.com
ALLOWED_SANDBOX_MODES=read-only,workspace-write
BEDROCK_API_KEY_SECRET_ARN=
# Break-glass escape hatch. Production should use worker-minted short-term Bedrock tokens instead.
ALLOW_AGENT_AWS_CREDENTIAL_CHAIN=false

# Provider secret ARNs are deployment inputs. Never put plaintext tokens here in production.
GITHUB_WEBHOOK_SECRET_ARN=
GITHUB_CLONE_TOKEN_SECRET_ARN=
GITHUB_NOTIFY_TOKEN_SECRET_ARN=
GITHUB_COMMENT_TRIGGER=@indubitably
GITLAB_WEBHOOK_SECRET_ARN=
GITLAB_CLONE_TOKEN_SECRET_ARN=
GITLAB_NOTIFY_TOKEN_SECRET_ARN=
GITLAB_COMMENT_TRIGGER=@indubitably
TEAMS_OUTGOING_WEBHOOK_SECRET_ARN=
TEAMS_DELIVERY_MODE=workflow
TEAMS_WORKFLOW_URL_SECRET_ARN=
# Use only with TEAMS_DELIVERY_MODE=threaded-gateway. The secret contains a trusted gateway URL.
TEAMS_REPLY_GATEWAY_URL_SECRET_ARN=
TEAMS_ROUTES_JSON={}
SLACK_SIGNING_SECRET_ARN=
SLACK_BOT_TOKEN_SECRET_ARN=
