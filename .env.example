AWS_REGION=us-east-1
AGENT_RUNTIME_API_URL=https://example.execute-api.us-east-1.amazonaws.com
DEFAULT_EXECUTION_BACKEND=ecs
DEFAULT_AGENT_DRIVER=mock
DEFAULT_MODEL=
ALLOWED_REPOSITORY_HOSTS=github.com,gitlab.com
ALLOWED_SANDBOX_MODES=read-only,workspace-write
BEDROCK_API_KEY_SECRET_ARN=
# Local-only escape hatch. Production should use a scoped Bedrock API key instead.
ALLOW_AGENT_AWS_CREDENTIAL_CHAIN=false

# Provider secret ARNs are deployment inputs. Never put plaintext tokens here in production.
GITHUB_WEBHOOK_SECRET_ARN=
GITHUB_CLONE_TOKEN_SECRET_ARN=
GITHUB_NOTIFY_TOKEN_SECRET_ARN=
GITHUB_COMMENT_TRIGGER=@indubitably
GITLAB_WEBHOOK_SECRET_ARN=
GITLAB_CLONE_TOKEN_SECRET_ARN=
GITLAB_NOTIFY_TOKEN_SECRET_ARN=
GITLAB_COMMENT_TRIGGER=@indubitably
TEAMS_OUTGOING_WEBHOOK_SECRET_ARN=
TEAMS_WORKFLOW_URL_SECRET_ARN=
TEAMS_ROUTES_JSON={}
SLACK_SIGNING_SECRET_ARN=
SLACK_BOT_TOKEN_SECRET_ARN=
