+                        SeccompCmpArgLen::Dword,
+                        SeccompCmpOp::Ne,
+                        libc::SO_TYPE as u64,
+                    )?])?,
+                ],
+            );
             deny_syscall(&mut rules, libc::SYS_setsockopt);
 
