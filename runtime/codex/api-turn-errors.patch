+// Typed failures take precedence over a transport status without retaining the
+// provider body in the resulting error.
+fn typed_error_body(body: &str) -> Option<CodexErr> {
+    let value = serde_json::from_str::<Value>(body).ok()?;
+    match value.get("error")?.get("code")?.as_str()? {
+        "credit_balance_exhausted" => Some(CodexErr::CreditBalanceExhausted),
+        "context_length_exceeded" => Some(CodexErr::ContextWindowExceeded),
+        "session_budget_exceeded" => Some(CodexErr::SessionBudgetExceeded),
+        "insufficient_quota" | "usage_limit_exceeded" => Some(CodexErr::QuotaExceeded),
+        "server_error" => Some(CodexErr::InternalServerError),
+        "server_overloaded" | "server_is_overloaded" => Some(CodexErr::ServerOverloaded),
+        "request_timeout" => Some(CodexErr::RequestTimeout),
+        _ => None,
+    }
+}
+
 const ACTIVE_LIMIT_HEADER: &str = "x-codex-active-limit";
 const REQUEST_ID_HEADER: &str = "x-request-id";
 const OAI_REQUEST_ID_HEADER: &str = "x-oai-request-id";
