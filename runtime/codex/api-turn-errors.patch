 }
+
+#[test]
+fn credit_balance_errors_preserve_their_category_and_do_not_retry() {
+    let body =
+        r#"{"error":{"code":"credit_balance_exhausted","message":"private provider diagnostic"}}"#;
+    for error in [
+        ApiError::CreditBalanceExhausted,
+        ApiError::Api {
+            status: http::StatusCode::PAYMENT_REQUIRED,
+            message: body.to_string(),
+        },
+        ApiError::Transport(TransportError::Http {
+            retry_after: None,
+            status: http::StatusCode::TOO_MANY_REQUESTS,
+            url: None,
+            headers: None,
+            body: Some(body.to_string()),
+        }),
+    ] {
+        let mapped = map_api_error(error);
+        assert_eq!(
+            mapped.to_codex_protocol_error(),
+            CodexErrorInfo::CreditBalanceExhausted
+        );
+        assert!(mapped.retry_delay(1).is_none());
+        assert_eq!(mapped.to_string(), "API credit balance exhausted.");
+    }
+}
+
+#[test]
+fn typed_provider_errors_are_independent_of_http_transport_status() {
+    for (code, expected) in [
+        (
+            "context_length_exceeded",
+            CodexErrorInfo::ContextWindowExceeded,
+        ),
+        ("insufficient_quota", CodexErrorInfo::UsageLimitExceeded),
+        (
+            "session_budget_exceeded",
+            CodexErrorInfo::SessionBudgetExceeded,
+        ),
+        ("server_error", CodexErrorInfo::InternalServerError),
+        ("server_overloaded", CodexErrorInfo::ServerOverloaded),
+        ("request_timeout", CodexErrorInfo::RequestTimeout),
+    ] {
+        let body = serde_json::json!({"error": {"code": code, "message": "private diagnostic"}})
+            .to_string();
+        for error in [
+            ApiError::Api {
+                status: http::StatusCode::BAD_REQUEST,
+                message: body.clone(),
+            },
+            ApiError::Transport(TransportError::Http {
+                retry_after: None,
+                status: http::StatusCode::BAD_REQUEST,
+                url: None,
+                headers: None,
+                body: Some(body),
+            }),
+        ] {
+            let mapped = map_api_error(error);
+            assert_eq!(mapped.to_codex_protocol_error(), expected);
+            assert!(!mapped.to_string().contains("private diagnostic"));
+        }
+    }
+}
