@@ -521,3 +521,30 @@ fn map_api_error_extracts_identity_auth_details_from_headers() {
     );
     assert_eq!(err.identity_error_code.as_deref(), Some("token_expired"));
 }
+
+#[test]
+fn credit_balance_errors_preserve_their_category_and_do_not_retry() {
+    let body =
+        r#"{"error":{"code":"credit_balance_exhausted","message":"private provider diagnostic"}}"#;
+    for error in [
+        ApiError::CreditBalanceExhausted,
+        ApiError::Api {
+            status: http::StatusCode::PAYMENT_REQUIRED,
+            message: body.to_string(),
+        },
+        ApiError::Transport(TransportError::Http {
+            status: http::StatusCode::TOO_MANY_REQUESTS,
+            url: None,
+            headers: None,
+            body: Some(body.to_string()),
+        }),
+    ] {
+        let mapped = map_api_error(error);
+        assert_eq!(
+            mapped.to_codex_protocol_error(),
+            CodexErrorInfo::CreditBalanceExhausted
+        );
+        assert!(!mapped.is_retryable());
+        assert_eq!(mapped.to_string(), "API credit balance exhausted.");
+    }
+}
