+fn service_tier_test_client(
+    base_url: String,
+    auth: Option<CodexAuth>,
+    supports_websockets: bool,
+) -> ModelClient {
+    let mut provider = ModelProviderInfo::create_openai_provider(Some(base_url));
+    provider.requires_openai_auth = auth.is_some();
+    provider.supports_websockets = supports_websockets;
+    provider.request_max_retries = Some(0);
+    provider.stream_max_retries = Some(0);
+    provider.stream_idle_timeout_ms = Some(5_000);
+    ModelClient::new(
+        auth.map(AuthManager::from_auth_for_testing),
+        AgentIdentityAuthPolicy::JwtOnly,
+        ThreadId::new(),
+        provider,
+        SessionSource::Cli,
+        "test_originator".to_string(),
+        /*model_verbosity*/ None,
+        /*content_item_kinds_enabled*/ true,
+        /*enable_request_compression*/ false,
+        /*include_timing_metrics*/ false,
+        /*beta_features_header*/ None,
+        /*concurrent_reasoning_summaries_enabled*/ false,
+        /*attestation_provider*/ None,
+        HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault),
+    )
+}
+
+async fn stream_service_tier_sequence(client: &ModelClient) -> anyhow::Result<()> {
+    let mut session = client.new_session();
+    let mut prompt = Prompt::default();
+    for (index, service_tier) in REQUEST_SERVICE_TIERS.into_iter().enumerate() {
+        prompt.input.push(ResponseItem::Message {
+            id: None,
+            role: "user".to_string(),
+            content: vec![ContentItem::InputText {
+                text: format!("turn {index}"),
+            }],
+            phase: None,
+            internal_chat_message_metadata_passthrough: None,
+        });
+        let metadata = test_responses_metadata_for_client(
+            client,
+            Some(&format!("turn-{index}")),
+            format!("{}:0", client.state.thread_id),
+            /*parent_thread_id*/ None,
+            TestCodexResponsesRequestKind::Turn,
+        );
+        let mut stream = session
+            .stream(
+                &prompt,
+                &test_model_info(),
+                &test_session_telemetry(),
+                /*effort*/ None,
+                codex_protocol::config_types::ReasoningSummary::None,
+                service_tier.map(str::to_string),
+                &metadata,
+                &InferenceTraceContext::disabled(),
+            )
+            .await?;
+        let mut completed = false;
+        while let Some(event) = stream.next().await {
+            if let ResponseEvent::Completed { response_id, .. } = event? {
+                assert_eq!(response_id, format!("resp-{index}"));
+                completed = true;
+            }
+        }
+        assert!(completed, "response stream should complete");
+    }
+    Ok(())
+}
