+#[tokio::test]
+async fn responses_service_tier_websocket_uses_auth_contract(
+    auth: Option<CodexAuth>,
+    expected_tiers: [Option<&str>; 8],
+) -> anyhow::Result<()> {
+    let responses = REQUEST_SERVICE_TIERS
+        .iter()
+        .enumerate()
+        .map(|(index, _)| {
+            vec![
+                ev_response_created(&format!("resp-{index}")),
+                ev_completed(&format!("resp-{index}")),
+            ]
+        })
+        .collect();
+    let server = start_websocket_server(vec![responses]).await;
+    let client = service_tier_test_client(
+        format!("{}/v1", server.uri()),
+        auth,
+        /*supports_websockets*/ true,
+    );
+
+    stream_service_tier_sequence(&client).await?;
+
+    let requests = server.single_connection();
+    assert_eq!(requests.len(), expected_tiers.len());
+    for (request, expected_tier) in requests.iter().zip(expected_tiers) {
+        assert_eq!(
+            request.body_json().get("service_tier"),
+            expected_tier.map(serde_json::Value::from).as_ref(),
+        );
+    }
+    assert!(
+        requests[2]
+            .body_json()
+            .get("previous_response_id")
+            .is_none()
+    );
+    assert_eq!(requests[3].body_json()["previous_response_id"], "resp-2");
+    server.shutdown().await;
+    Ok(())
+}
