+#[tokio::test]
+async fn exit_watcher_preserves_output_emitted_before_streaming_starts() -> anyhow::Result<()> {
+    let StreamingOutputHarness {
+        process,
+        stdout_tx,
+        exit_tx,
+        transcript,
+        context,
+        rx_event,
+    } = unstarted_streaming_output_harness().await?;
+    let output_handles = process.output_handles();
+    let early_output_buffered = output_handles.output_notify.notified();
+    tokio::pin!(early_output_buffered);
+    early_output_buffered.as_mut().enable();
+
+    stdout_tx
+        .send(b"EARLY-OUTPUT-MARKER\n".to_vec())
+        .expect("send early output");
+    early_output_buffered.await;
+    let tool_output = std::mem::take(&mut *output_handles.output_buffer.lock().await);
+    assert_eq!(tool_output.to_bytes(), b"EARLY-OUTPUT-MARKER\n");
+
+    start_streaming_output(&process, &context, Arc::clone(&transcript));
+    let cwd = context
+        .step_context
+        .environments
+        .primary()
+        .expect("primary environment")
+        .cwd()
+        .clone();
+    spawn_exit_watcher(
+        Arc::clone(&process),
+        Arc::clone(&context.session),
+        Arc::clone(&context.step_context.turn),
+        context.call_id.clone(),
+        vec!["proof".to_string()],
+        cwd,
+        /*process_id*/ 123,
+        /*plugin_attribution*/ None,
+        transcript,
+        Instant::now(),
+        /*network_denial_monitor*/ None,
+        /*plugin_metrics_sidecar*/ None,
+    );
+    drop(context);
+
+    stdout_tx
+        .send(b"LATE-OUTPUT-MARKER\n".to_vec())
+        .expect("send late output");
+    drop(stdout_tx);
+    exit_tx.send(0).expect("send exit");
+
+    let mut streamed_output = Vec::new();
+    let mut completions = Vec::new();
+    while let Ok(event) = rx_event.recv().await {
+        match event.msg {
+            EventMsg::ExecCommandOutputDelta(delta) => streamed_output.extend(delta.chunk),
+            EventMsg::ItemCompleted(completed) => {
+                let TurnItem::CommandExecution(item) = completed.item else {
+                    panic!("expected CommandExecution");
+                };
+                completions.push((item.status, item.exit_code, item.aggregated_output));
+            }
+            EventMsg::ExecCommandEnd(_) => {}
+            event => panic!("unexpected event: {event:?}"),
+        }
+    }
+    assert_eq!(
+        completions,
+        vec![(
+            CommandExecutionStatus::Completed,
+            Some(0),
+            Some("EARLY-OUTPUT-MARKER\nLATE-OUTPUT-MARKER\n".to_string()),
+        )]
+    );
+    assert_eq!(
+        streamed_output,
+        b"EARLY-OUTPUT-MARKER\nLATE-OUTPUT-MARKER\n"
+    );
+
+    Ok(())
+}
