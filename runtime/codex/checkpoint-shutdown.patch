 impl ThreadManager {
+    /// Checkpoints the exact visible set after host-side admission has been sealed.
+    /// Upstream tree shutdown accounts for internal sessions and admitted startup work.
+    pub async fn checkpoint_idle_threads(
+        &self,
+        root: ThreadId,
+        expected: Vec<ThreadId>,
+    ) -> CodexResult<Vec<ThreadId>> {
+        let expected_set: HashSet<_> = expected.iter().copied().collect();
+        if expected.is_empty()
+            || expected.len() > 1000
+            || expected_set.len() != expected.len()
+            || !expected_set.contains(&root)
+        {
+            return Err(CodexErr::InvalidRequest(
+                "checkpoint requires a unique bounded thread set containing the root".to_owned(),
+            ));
+        }
+        let captured: HashMap<_, _> = self
+            .state
+            .threads
+            .read()
+            .await
+            .iter()
+            .filter(|(_, thread)| !thread.session_source.is_internal())
+            .map(|(id, thread)| (*id, Arc::clone(thread)))
+            .collect();
+        if captured.len() != expected_set.len()
+            || captured.keys().any(|id| !expected_set.contains(id))
+        {
+            return Err(CodexErr::InvalidRequest(
+                "checkpoint thread set does not match loaded threads".to_owned(),
+            ));
+        }
+        for thread in captured.values() {
+            if thread.session.active_turn.lock().await.is_some()
+                || thread.session.live_thread().is_none()
+            {
+                return Err(CodexErr::InvalidRequest(
+                    "checkpoint requires idle durable threads".to_owned(),
+                ));
+            }
+        }
+        // Retain exact lifetimes because tree shutdown can remove a child from the registry.
+        let shutdowns: Vec<_> = captured
+            .values()
+            .map(|thread| AgentTreeShutdown {
+                state: thread
+                    .session
+                    .services
+                    .local_agent_runtime
+                    .request_shutdown(),
+            })
+            .collect();
+        for shutdown in shutdowns {
+            shutdown.wait_detailed().await.map_err(|_| {
+                CodexErr::Fatal("checkpoint persistence shutdown failed".to_owned())
+            })?;
+        }
+        let loaded = self.state.threads.read().await;
+        if loaded.iter().any(|(id, thread)| {
+            !thread.session_source.is_internal()
+                && !captured
+                    .get(id)
+                    .is_some_and(|before| Arc::ptr_eq(before, thread))
+        }) {
+            return Err(CodexErr::InvalidRequest(
+                "checkpoint thread set changed during shutdown".to_owned(),
+            ));
+        }
+        Ok(expected)
+    }
+
     /// Unloads this exact idle MAv2 child using the manager's local controller backend,
     /// preserving mail and environments for reloading. Host controllers own their eviction
     /// and recovery; managers configured with a host controller factory are rejected.
