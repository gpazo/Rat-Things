+#[tokio::test]
+async fn checkpoint_idle_threads_rejects_invalid_expected_sets_without_stopping_threads()
+-> Result<()> {
+    use codex_protocol::ThreadId;
+
+    let server = start_mock_server().await;
+    let test = test_codex().build_with_auto_env(&server).await?;
+    let root = test.session_configured.thread_id;
+    let other = test
+        .thread_manager
+        .start_thread(test.start_thread_options().await)
+        .await?;
+    let cases = vec![
+        vec![],
+        vec![root, root, other.thread_id],
+        vec![other.thread_id],
+        vec![root],
+        vec![root, other.thread_id, ThreadId::new()],
+        std::iter::once(root)
+            .chain((0..1000).map(|_| ThreadId::new()))
+            .collect(),
+    ];
+    for expected in cases {
+        test.thread_manager
+            .checkpoint_idle_threads(root, expected)
+            .await
+            .expect_err("invalid expected set must fail");
+        assert!(test.codex.wait_until_terminated().now_or_never().is_none());
+        assert!(
+            other
+                .thread
+                .wait_until_terminated()
+                .now_or_never()
+                .is_none()
+        );
+    }
+    tokio::time::timeout(
+        Duration::from_secs(10),
+        test.thread_manager
+            .checkpoint_idle_threads(root, vec![root, other.thread_id]),
+    )
+    .await??;
+    Ok(())
+}
