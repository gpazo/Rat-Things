+    /// Private host handoff primitive. The host must seal admission on every thread.
+    pub(crate) async fn thread_checkpoint(
+        &self,
+        params: codex_app_server_protocol::ThreadCheckpointParams,
+    ) -> Result<Option<ClientResponsePayload>, JSONRPCErrorError> {
+        let root = ThreadId::from_string(&params.thread_id)
+            .map_err(|_| invalid_request("invalid checkpoint thread id"))?;
+        if params.expected_thread_ids.is_empty() || params.expected_thread_ids.len() > 1000 {
+            return Err(invalid_request(
+                "checkpoint requires 1 to 1000 expected threads",
+            ));
+        }
+        let expected = params
+            .expected_thread_ids
+            .iter()
+            .map(|id| {
+                ThreadId::from_string(id)
+                    .map_err(|_| invalid_request("invalid expected checkpoint thread id"))
+            })
+            .collect::<Result<Vec<_>, _>>()?;
+        let thread_ids = tokio::time::timeout(
+            Duration::from_secs(30),
+            self.thread_manager.checkpoint_idle_threads(root, expected),
+        )
+        .await
+        .map_err(|_| internal_error("checkpoint shutdown timed out"))?
+        .map_err(|_| internal_error("checkpoint shutdown was not durably acknowledged"))?;
+        Ok(Some(
+            codex_app_server_protocol::ThreadCheckpointResponse {
+                thread_id: params.thread_id,
+                thread_ids: thread_ids.into_iter().map(|id| id.to_string()).collect(),
+                flushed: true,
+            }
+            .into(),
+        ))
+    }
