+    /// A normal ShutdownComplete notification does not imply persistence succeeded.
+    pub async fn checkpoint_shutdown(&self) -> CodexResult<()> {
+        if self.session.active_turn.lock().await.is_some() || self.session.live_thread().is_none() {
+            return Err(CodexErr::UnsupportedOperation("checkpoint requires an idle durable thread".to_string()));
+        }
+        self.shutdown_and_wait().await?;
+        if !self.session.checkpoint_shutdown_succeeded.load(std::sync::atomic::Ordering::Acquire) {
+            return Err(CodexErr::Fatal("checkpoint persistence shutdown failed".to_string()));
+        }
+        Ok(())
+    }
+
     pub async fn shutdown_and_wait(&self) -> CodexResult<()> {
         self.io.shutdown_and_wait().await
     }
