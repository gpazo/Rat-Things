+#[tokio::test]
+async fn checkpoint_idle_threads_rejects_busy_child_before_stopping_any_thread() -> Result<()> {
+    use core_test_support::responses::mount_response_once_match;
+    use wiremock::ResponseTemplate;
+
+    let server = start_mock_server().await;
+    mount_root_collaboration_call(
+        &server,
+        FIRST_PROMPT,
+        "first-call",
+        "spawn_agent",
+        json!({"message": FIRST_TASK, "task_name": "first", "fork_turns": "none"}),
+    )
+    .await;
+    mount_response_once_match(
+        &server,
+        |request: &wiremock::Request| {
+            body_contains(request, FIRST_TASK) && !has_function_call_output(request, "first-call")
+        },
+        ResponseTemplate::new(200)
+            .insert_header("content-type", "text/event-stream")
+            .set_body_string(sse(vec![
+                ev_response_created("busy-worker"),
+                ev_completed("busy-worker"),
+            ]))
+            .set_delay(Duration::from_secs(60)),
+    )
+    .await;
+    let test = test_codex()
+        .with_model("gpt-5.6-sol")
+        .with_config(|config| {
+            config.features.enable(Feature::Collab).unwrap();
+            config.features.enable(Feature::MultiAgentV2).unwrap();
+        })
+        .build_with_auto_env(&server)
+        .await?;
+    test.submit_turn(FIRST_PROMPT).await?;
+    let root = test.session_configured.thread_id;
+    let worker_id = test
+        .thread_manager
+        .list_thread_ids()
+        .await
+        .into_iter()
+        .find(|id| *id != root)
+        .expect("spawned worker");
+    let worker = test.thread_manager.get_thread(worker_id).await?;
+    wait_for_event(&worker, |event| matches!(event, EventMsg::TurnStarted(_))).await;
+    test.thread_manager
+        .checkpoint_idle_threads(root, vec![root, worker_id])
+        .await
+        .expect_err("busy child must prevent checkpoint");
+    assert!(test.codex.wait_until_terminated().now_or_never().is_none());
+    assert!(worker.wait_until_terminated().now_or_never().is_none());
+    let shutdown = test
+        .thread_manager
+        .request_agent_tree_shutdown(root)
+        .await?;
+    tokio::time::timeout(Duration::from_secs(10), shutdown.wait_detailed()).await??;
+    Ok(())
+}
